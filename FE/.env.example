# Copy this file to .env and fill in the values for your local environment.
# .env is git-ignored and must never be committed.

# Base URL of the backend API (SelfStorageSystem-BE). Defaults to the local dev backend port if unset.
VITE_API_URL=http://localhost:51283/api

# Google OAuth 2.0 Client ID used for "Continue with Google" sign-in.
# Must match a Client ID configured in Google Cloud Console with this app's origin
# (e.g. http://localhost:5173) listed under "Authorized JavaScript origins".
# Without this variable, Google sign-in is disabled and shows a clear error instead of failing silently.
VITE_GOOGLE_CLIENT_ID=
