# ==============================================================================
# Environment Configuration Template for G1 SelfStorage Frontend
# Copy to .env or .env.local for local overrides: cp .env.example .env
# ==============================================================================

# Backend API Base URL (must end with /api)
VITE_API_URL=http://localhost:51283/api

# HTTP Request Timeout (in milliseconds)
VITE_API_TIMEOUT_MS=15000

# Application Branding & Display Name
VITE_APP_NAME=G1 SelfStorage

# Default Currency Code (VND / USD)
VITE_DEFAULT_CURRENCY=VND

# Google OAuth 2.0 Client ID (Authorized JavaScript origins must include your exact browser origin)
VITE_GOOGLE_CLIENT_ID=827798715826-ef477sod2l5a1f34484no0v78r1fbdsl.apps.googleusercontent.com
